diff --git a/dash/_arrow.py b/dash/_arrow.py
new file mode 100644
index 0000000..4ad046e
--- /dev/null
+++ b/dash/_arrow.py
@@ -0,0 +1,161 @@
+"""Send figure data in callback responses as an Arrow IPC stream.
+
+When the renderer accepts Arrow, every array in a returned ``figure`` that
+Arrow can carry is replaced by a placeholder ``{"__arrow__": i}``:
+
+* Arrow-backed arrays: Polars Series, pandas Series with a pyarrow dtype,
+  pyarrow Array / ChunkedArray (anything implementing the Arrow PyCapsule
+  interface);
+* numpy arrays, which is what ``go.Figure`` and ``px`` store after validating
+  their input, so existing figure code needs no change.
+
+The response is then one Arrow IPC stream:
+
+* column ``i`` holds array ``i`` as a single list value, so arrays of
+  different lengths share one record batch;
+* the rest of the response is JSON in the schema metadata under ``"dash"``.
+
+The renderer reads the stream, turns each column into a typed array (dates
+into what plotly.js reads) and puts it back where its placeholder was.
+Responses without such arrays, and clients that do not accept Arrow, get JSON
+exactly as before.
+"""
+
+import sys
+
+from ._utils import to_json
+
+ARROW_MIMETYPE = "application/vnd.apache.arrow.stream"
+PLACEHOLDER = "__arrow__"
+MAX_LIST_LENGTH = 2**31 - 1  # Arrow list offsets are int32
+
+
+def to_arrow_response(response, callback_ctx, request_headers):
+    """Return the response as Arrow IPC bytes, or None to send JSON."""
+    callback_ctx.dash_response.append_header("Vary", "Accept")
+    if ARROW_MIMETYPE not in request_headers.get("Accept", ""):
+        return None
+
+    arrays = []
+    envelope = {
+        **response,
+        "response": {
+            component: {
+                prop: _replace_arrays(value, arrays) if prop == "figure" else value
+                for prop, value in props.items()
+            }
+            for component, props in response.get("response", {}).items()
+        },
+    }
+    if not arrays:
+        return None
+
+    import pyarrow as pa  # pylint: disable=import-outside-toplevel
+
+    columns = [
+        pa.ListArray.from_arrays(pa.array([0, len(array)], pa.int32()), array)
+        for array in arrays
+    ]
+    batch = pa.RecordBatch.from_arrays(columns, names=[str(i) for i in range(len(columns))])
+    batch = batch.replace_schema_metadata({"dash": to_json(envelope)})
+    sink = pa.BufferOutputStream()
+    with pa.ipc.new_stream(sink, batch.schema) as writer:
+        writer.write_batch(batch)
+
+    callback_ctx.dash_response.set_header("Content-Type", ARROW_MIMETYPE)
+    return sink.getvalue().to_pybytes()
+
+
+def _replace_arrays(value, arrays):
+    """Copy ``value``, swapping arrays Arrow can carry for placeholders."""
+    if _is_plotly_figure(value):
+        # plotly.py keeps the validated numpy arrays here; to_plotly_json()
+        # would turn them into base64 and lists first.
+        if value.frames:
+            return value
+        value = {"data": value._data, "layout": value._layout}  # pylint: disable=protected-access
+    if isinstance(value, dict):
+        return {key: _replace_arrays(item, arrays) for key, item in value.items()}
+    if isinstance(value, (list, tuple)):
+        # Only walk containers of containers (lists of traces, say). A list of
+        # numbers or strings is plain data and walking it would be slow.
+        if value and isinstance(value[0], (dict, list, tuple)):
+            return [_replace_arrays(item, arrays) for item in value]
+        return value
+    array = _as_arrow_array(value)
+    if array is None:
+        return value
+    return {PLACEHOLDER: _add_array(arrays, array)}
+
+
+def _add_array(arrays, array):
+    """Index of the column that will carry ``array``."""
+    arrays.append(array)
+    return len(arrays) - 1
+
+
+def _is_plotly_figure(value):
+    plotly = sys.modules.get("plotly.basedatatypes")  # no import: only figures that exist
+    return plotly is not None and isinstance(value, plotly.BaseFigure)
+
+
+def _as_arrow_array(value):
+    """A single-chunk pyarrow Array for a value Arrow can carry, else None."""
+    if not (
+        hasattr(value, "__arrow_c_stream__")
+        or hasattr(value, "__arrow_c_array__")
+        or type(value).__module__ == "numpy"
+    ):
+        return None
+
+    import pyarrow as pa  # pylint: disable=import-outside-toplevel
+
+    try:
+        if hasattr(value, "__arrow_c_stream__"):
+            array = pa.chunked_array(value)
+            array = array.chunk(0) if array.num_chunks == 1 else array.combine_chunks()
+        elif hasattr(value, "__arrow_c_array__"):
+            array = pa.array(value)
+        else:
+            array = _numpy_to_arrow(value)
+    except (TypeError, ValueError, pa.ArrowException):
+        return None
+    if array is None or not _is_supported(array.type) or len(array) > MAX_LIST_LENGTH:
+        return None
+    if pa.types.is_timestamp(array.type) and array.type.tz is not None:
+        # plotly.py sends tz-aware times as wall-clock strings in their own
+        # timezone and plotly.js shows that wall clock; send the same.
+        import pyarrow.compute as pc  # pylint: disable=import-outside-toplevel
+
+        array = pc.local_timestamp(array)
+    return array
+
+
+def _numpy_to_arrow(array):
+    import pyarrow as pa  # pylint: disable=import-outside-toplevel
+
+    if array.ndim != 1:
+        return None
+    if array.dtype.kind in "fiuM":
+        return pa.array(array)  # no copy for numbers
+    if array.dtype.kind == "O" and len(array) and _is_timestamp(array[0]):
+        # go.Figure stores tz-aware datetimes as an object array of Timestamps.
+        import pandas as pd  # pylint: disable=import-outside-toplevel
+
+        return pa.array(pd.DatetimeIndex(array))
+    return None
+
+
+def _is_timestamp(value):
+    pandas = sys.modules.get("pandas")
+    return pandas is not None and isinstance(value, pandas.Timestamp)
+
+
+def _is_supported(arrow_type):
+    """Types the renderer turns into something plotly.js reads natively."""
+    import pyarrow.types as t  # pylint: disable=import-outside-toplevel
+
+    if t.is_timestamp(arrow_type) or t.is_float32(arrow_type) or t.is_float64(arrow_type):
+        return True
+    # 64-bit integers would arrive as BigInt64Array, which plotly.js cannot plot.
+    return t.is_integer(arrow_type) and arrow_type.bit_width <= 32
