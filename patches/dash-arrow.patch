diff --git a/dash/dash-renderer/src/actions/arrowResponse.ts b/dash/dash-renderer/src/actions/arrowResponse.ts
new file mode 100644
index 0000000..23ce67e
--- /dev/null
+++ b/dash/dash-renderer/src/actions/arrowResponse.ts
@@ -0,0 +1,96 @@
+import {DataType, TimeUnit, tableFromIPC, type Vector} from 'apache-arrow';
+
+// Server side: dash/_arrow.py. Each column holds one array as a single list
+// value; the rest of the response is JSON in the schema metadata, with
+// {"__arrow__": i} wherever column i belongs.
+export const ARROW_MIMETYPE = 'application/vnd.apache.arrow.stream';
+const PLACEHOLDER = '__arrow__';
+
+export function decodeArrowResponse(buffer: ArrayBuffer) {
+    const table = tableFromIPC(new Uint8Array(buffer));
+    const arrays = table.schema.fields.map((_field, i) =>
+        toPlotlyArray(table.getChildAt(i)!.get(0) as Vector)
+    );
+    return JSON.parse(table.schema.metadata.get('dash')!, (_key, value) =>
+        value !== null && typeof value === 'object' && PLACEHOLDER in value
+            ? arrays[value[PLACEHOLDER]]
+            : value
+    );
+}
+
+function toPlotlyArray(values: Vector): ArrayLike<unknown> {
+    if (DataType.isTimestamp(values.type)) {
+        return plotlyDates(values);
+    }
+    if (values.nullCount === 0) {
+        // A view on the received buffer, no copy.
+        return values.toArray();
+    }
+    if (DataType.isFloat(values.type)) {
+        return nullsAsNaN(values);
+    }
+    return Array.from(values);
+}
+
+// Null slots hold arbitrary values in the data buffer; plotly.js shows NaN as a gap.
+function nullsAsNaN(values: Vector) {
+    const result = (values.toArray() as Float32Array | Float64Array).slice();
+    for (let i = 0; i < result.length; i++) {
+        if (!values.isValid(i)) result[i] = NaN;
+    }
+    return result;
+}
+
+// Timestamps arrive as wall-clock time (dash/_arrow.py drops time zones the
+// way plotly.py's JSON does). Stock plotly.js reads date axes from strings;
+// bare numbers would be taken as local-time milliseconds.
+const MS_PER_UNIT = {
+    [TimeUnit.SECOND]: 1e3,
+    [TimeUnit.MILLISECOND]: 1,
+    [TimeUnit.MICROSECOND]: 1e-3,
+    [TimeUnit.NANOSECOND]: 1e-6
+};
+const DAY_MS = 86_400_000;
+
+function plotlyDates(values: Vector) {
+    const scale = MS_PER_UNIT[values.type.unit as TimeUnit];
+    const raw = values.toArray() as BigInt64Array;
+    const ms = new Float64Array(raw.length);
+    for (let i = 0; i < raw.length; i++) ms[i] = Number(raw[i]) * scale;
+    // plotly.js with patches/optimisations/plotly-date-typed-array.patch sets
+    // this flag and takes UTC milliseconds as they are.
+    if ((window as any).Plotly?.typedDateAxes) {
+        for (let i = 0; values.nullCount && i < ms.length; i++) if (!values.isValid(i)) ms[i] = NaN;
+        return ms;
+    }
+    const dates: (string | null)[] = isoStrings(ms);
+    for (let i = 0; values.nullCount && i < ms.length; i++) {
+        if (!values.isValid(i)) dates[i] = null;
+    }
+    return dates;
+}
+
+// ISO strings without a Date per value: the date part is made once per day,
+// the time part once per second of the day.
+const timeOfDay: string[] = [];
+const pad = (n: number) => (n < 10 ? '0' : '') + n;
+
+function isoStrings(ms: Float64Array) {
+    const dates = new Array<string>(ms.length);
+    let dayStart = NaN;
+    let prefix = '';
+    for (let i = 0; i < ms.length; i++) {
+        const t = ms[i];
+        if (!(t >= dayStart && t < dayStart + DAY_MS)) {
+            dayStart = Math.floor(t / DAY_MS) * DAY_MS;
+            prefix = new Date(dayStart).toISOString().slice(0, 11);
+        }
+        const second = Math.floor((t - dayStart) / 1000);
+        const time = (timeOfDay[second] ??= `${pad(Math.floor(second / 3600))}:${pad(
+            Math.floor(second / 60) % 60
+        )}:${pad(second % 60)}`);
+        const millis = Math.round(t - dayStart - second * 1000);
+        dates[i] = millis ? `${prefix}${time}.${String(millis).padStart(3, '0')}` : prefix + time;
+    }
+    return dates;
+}
